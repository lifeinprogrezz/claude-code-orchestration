[Unit]
Description=claude-code-router (ccr) daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# bash -lc + explicit nvm sourcing so the `ccr` binary resolves on PATH.
# (A non-interactive login shell does NOT auto-source nvm — without the explicit
#  source, ExecStart exits 127 "ccr: not found" and the service crash-loops.)
ExecStart=/bin/bash -lc 'export NVM_DIR="$HOME/.nvm"; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"; exec ccr start'
Restart=always
RestartSec=3
# ccr listens on 127.0.0.1:3456 by default

[Install]
WantedBy=default.target
